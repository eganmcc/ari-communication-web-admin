# Agent Dashboard Environment Variables
# Copy this file to .env and update with your server details

# Production domain (used for Socket.IO connections)
# Example: https://livewire.ptdika.local
VITE_SERVER_DOMAIN=https://your-domain.com

# ARI Bridge Socket.IO URL
# Example: https://livewire.ptdika.local or http://10.0.3.230:3100
VITE_SOCKET_URL=https://your-domain.com

# Voice API URL (port 3001)
# Example: https://livewire.ptdika.local or http://10.0.3.230:3001
VITE_API_URL=https://your-domain.com

# Dialer API URL (port 4001)
# Example: https://livewire.ptdika.local or http://10.0.3.230:4001
VITE_DIALER_URL=https://your-domain.com

# Development fallbacks (optional)
# Uncomment if running in development mode without production domain
# VITE_DEV_SERVER_IP=10.0.3.230
